# AthenaK input file: nonlinear streaming instability, run AB of Johansen & Youdin
# (2007, ApJ 662, 627; Table 1): tau_s = 0.1, eps = 1.0, box 2 eta r square in
# the 2D r-z shearing box (x1 = r, x2 = z; azimuthal components in IM3/IPVZ; plain
# periodic x1), eta v_K = 0.05 c_s (Omega = c_s = 1, so eta r = 0.05 H), warm start
# from the NSH drift equilibrium with randomly placed particles (dust_nsh pgen), with
# ADAPTIVE MESH REFINEMENT on the particle-mesh dust density (dust track, Phase 6).
# JY07 ran 256^2 with 1.6e6 particles (~24 per cell) to t = 50.  Here the root grid
# is 128^2 in 16^2 MeshBlocks and MeshBlocks whose maximum dust density exceeds
# <amr_criterion1>/value_max are refined to level 1 (the dust module's one-level limit),
# with particles/split_on_refine so the particles of a refining block become four
# quarter-mass children half a fine cell apart (the sampling per cell is preserved on the
# fine level).  Uniform twins: mesh_refinement/refinement=none [mesh/nx1=256 mesh/nx2=256].
# Outputs: history (gas), particle history (.phst: max PM dust density, dispersions),
# binary dumps of the PM dust density and the gas for figures.

<comment>
problem   = JY07 AB streaming instability, 2D r-z, AMR on the dust density

<job>
basename  = si_AB

<mesh>
nghost    = 4             # even (refinement); ppmx needs >= 3
nx1       = 128           # radial
x1min     = -0.05
x1max     = 0.05
ix1_bc    = periodic      # 2D r-z: no azimuthal shift, plain periodic
ox1_bc    = periodic
nx2       = 128           # vertical
x2min     = -0.05
x2max     = 0.05
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16            # 8x8 root MeshBlocks (>= 2*nghost for the deposit injection)
nx2       = 16
nx3       = 1

<mesh_refinement>
refinement = adaptive
num_levels = 2            # root + 1 refined level (the dust module's limit)
ncycle_check = 10         # cycles between criterion checks (each deposits rho_dust)
refinement_interval = 20  # min cycles between (de)refinement of the same MeshBlock
max_nmb_per_rank = 320    # 64 root blocks, up to 256 refined

<amr_criterion1>
method    = min_max
variable  = dust_rho      # particle-mesh dust density (dust module's TSC deposit)
value_max = 4.0          # refine a block whose maximum exceeds this (4x the mean),
                          # derefine when it falls below

<time>
evolution  = dynamic
integrator = imex2+       # required for dust
cfl_number = 0.3
nlim       = -1
tlim       = 40.0
ndiag      = 1000

<hydro>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = ppmx
rsolver     = roe

<hydro_srcterms>
const_accel     = true    # radial pressure-gradient mimic on the gas only
const_accel_val = 0.1     # = 2*omega0*etavk
const_accel_dir = 1

<shearing_box>
qshear    = 1.5
omega0    = 1.0

<particles>
particle_type = dust
pusher        = imex_dust
ppc           = 16.0      # particles per root cell (JY07: ~24 at 256^2)
split_on_refine = true    # 2^d children per particle when its MeshBlock refines

<dust>
coupling      = imex
nspecies      = 1
taus_1        = 0.1
dust_to_gas   = 1.0
back_reaction = true
deposit       = tsc
gamma_switch  = false
dt_cfl        = 0.5
drag_solver   = local

<problem>
pgen_name     = dust_nsh
particle_placement = random   # warm start: shot noise seeds the instability
random_seed   = 1
check_equilibrium = false
user_hist     = true
rho0          = 1.0
etavk         = 0.05
eps_1         = 1.0

<output1>
file_type  = hst
dt         = 0.25
data_format = %.14e

<output2>
file_type  = phst         # particle history: dpm_max, per-species dispersions
dt         = 0.25

<output3>
file_type  = bin
variable   = dust_dpm     # PM dust density on the (refined) mesh
dt         = 2.0

<output4>
file_type  = bin
variable   = hydro_w
dt         = 2.0
