# Linear streaming instability at the parameters of JY07 run BA (tau_s = 1, eps = 0.2):
# the fastest Kx = Kz eigenmode, K = k eta r = 0.86 (s = 0.094720, Re omega = -0.522036
# from the YG05 dispersion relation with an isothermal gas, si_linear.py), seeded at a
# relative dust-density amplitude 1e-6 in a box of 4 x 1 wavelengths (1.46121 x 0.36530 H),
# root 16 cells per wavelength, the middle half refined once to 32.  Growth-rate convergence test: 32 cells per wavelength at the finest level.

# Variants: 16 and 64 cells per wavelength halve/double nx1, nx2 (the refined region
# scales with the box); the uniform twin is streaming_BA_linear.athinput.  Any other mode:
# scripts/analysis/si_linear.py TAUS EPS KX KZ prints the <problem> keys.  Data:
# validation/run/dust6/lin_BA (validation doc sec. 12.9).

<comment>
problem   = BA-mode linear growth, root 16 cells per wavelength, the middle half refined once to 32

<job>
basename  = lin_r32

<mesh>
nghost    = 4
nx1       = 64
x1min     = 0.0
x1max     = 1.4612058853906
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 0.36530147134765
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 1

<mesh_refinement>
refinement = static
prolong_limiter = minmod

<refined_region1>
level = 1                      # the middle half of the box, x in [L/4, 3L/4], full z
x1min = 0.379913530201556
x1max = 1.08129235518905
x2min = 0.0
x2max = 0.36530147134765
x3min = -0.5
x3max = 0.5

<time>
evolution  = dynamic
integrator = imex2+
cfl_number = 0.225
nlim       = -1
tlim       = 100.0
ndiag      = 100000

<hydro>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = ppmx
rsolver     = roe

<hydro_srcterms>
const_accel     = true
const_accel_val = 0.1
const_accel_dir = 1

<shearing_box>
qshear    = 1.5
omega0    = 1.0

<particles>
particle_type = dust
pusher        = imex_dust
ppc           = 1.0

<dust>
nspecies      = 1
taus_1        = 1.0
dust_to_gas   = 0.2
back_reaction = true
deposit       = tsc
gamma_switch  = false
dt_cfl        = 0.5
drag_solver   = local
drag_rtol     = 1.0e-11
drag_atol     = 1.0e-14
drag_iter_max = 200
drag_fail_policy = abort
drag_diagnostic_interval = 0

<problem>
pgen_name  = streaming_linear
lattice_finest = true
user_hist  = true
rho0       = 1.0
etavk      = 0.05
eps        = 0.2
kx         = 17.2
kz         = 17.2
omega_re   = -0.522036255269952
drhog_re   = -1.39853254752182e-10
drhog_im   = -5.47851183477182e-10
dugx_re    = -1.00681085023579e-09
dugx_im    = -1.50457918431061e-08
dugp_re    = 1.32729881638288e-08
dugp_im    = -2.94769165703946e-09
dugz_re    = 1.01521886070972e-09
dugz_im    = 1.50661400616511e-08
drhop_re   = 2e-07
dvpx_re    = 1.1967185272419e-08
dvpx_im    = -8.03265336415804e-09
dvpp_re    = 6.31924914088224e-09
dvpp_im    = 2.03185396216669e-09
dvpz_re    = -1.33452378887636e-09
dvpz_im    = 1.35396121110709e-08

<output1>
file_type  = hst
dt         = 0.25
data_format = %.14e

<output2>
file_type  = bin
variable   = dust_dpm
dt         = 5.0
