# AthenaK input file: linear streaming instability, mode linA (Youdin & Johansen 2007),
# 128^2 axisymmetric (r-z) shearing box, with STATIC MESH REFINEMENT (dust track,
# particles + SMR ladder, step 4).  Copy of athenak_dust_tests/inputs/
# streaming_linA_128.athinput with nghost = 4 (even, SMR) and the two middle radial
# columns x in [L/4, 3L/4] over the full vertical extent (8 of the 4x4 root MeshBlocks)
# refined to level 1: the shearing-box mesh policies apply even with the plain periodic
# x1 of the r-z geometry (x1-face blocks at root; refined regions span the full x2).  The
# eigenmode spans the whole box, so the growth rate (user history: mode projections of
# the particle mass distribution and the gas fields) is expected to match the
# uniform-mesh run to a few per cent; the radial level boundaries cut through the mode
# and the drifting particles cross them.
# Reference growth rate s = 0.4190204 (YJ07 linA); uniform 128^2 run: see the Phase 4a
# validation.  Run the same file with mesh_refinement/refinement=none for the uniform
# twin (nghost 4).

<job>
basename = linA_smr
<mesh>
nghost = 4
nx1 = 128
x1min = 0.0
x1max = 0.010471975511965976
ix1_bc = periodic
ox1_bc = periodic
nx2 = 128
x2min = 0.0
x2max = 0.010471975511965976
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic
<meshblock>
nx1 = 32
nx2 = 32
nx3 = 1
<mesh_refinement>
refinement = static
prolong_limiter = minmod     # minmod (default) | none: unlimited central slopes (diagnostic)
<refined_region1>
level = 1
x1min = 0.003                # strictly inside the middle two root columns (block edges at
x1max = 0.0075               # L/4 and 3L/4; a region edge within an ulp of a block edge
x2min = 0.0                  # would also pick the neighbouring block); full vertical
x2max = 0.010471975511965976 # extent: the annular policy of the shearing-box mesh
x3min = -0.5
x3max = 0.5
<time>
evolution = dynamic
integrator = imex2+
cfl_number = 0.225
nlim = -1
tlim = 10.0
ndiag = 100000
<hydro>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = ppmx
rsolver = roe
<hydro_srcterms>
const_accel = true
const_accel_val = 0.1
const_accel_dir = 1
<shearing_box>
qshear = 1.5
omega0 = 1.0
<particles>
particle_type = dust
pusher = imex_dust
ppc = 1.0
<dust>
nspecies = 1
taus_1 = 0.1
dust_to_gas = 3.0
back_reaction = true
deposit = tsc
gamma_switch = false
dt_cfl = 0.5
drag_solver = local
drag_rtol = 1.0e-11
drag_atol = 1.0e-14
drag_iter_max = 200
drag_fail_policy = abort
drag_diagnostic_interval = 0
<problem>
pgen_name = streaming_linear
lattice_finest = true        # lattice at the finest-level cell size on every block (SMR)
user_hist = true
rho0 = 1.0
etavk = 0.05
eps = 3.0
kx = 600.0
kz = 600.0
omega_re = 0.3480181522220716
drhog_re = 2.2390973021942755e-11
drhog_im = 2.120321162175151e-11
dugx_re = -8.45681860586763e-09
dugx_im = 1.8080318276365703e-09
dugp_re = 6.68355169629038e-09
dugp_im = 2.958364479042931e-09
dugz_re = 8.456774829225835e-09
dugz_im = -1.8080436236185242e-09
drhop_re = 3.0000000000000005e-06
dvpx_re = -6.992971139842195e-09
dvpx_im = 1.864998340789883e-09
dvpp_re = 6.528173354473428e-09
dvpp_im = 3.202761793127405e-09
dvpz_re = 8.197611012533743e-09
dvpz_im = -1.1666497869340141e-09
<output1>
file_type = hst
dcycle = 100
data_format = %.14e
