# AthenaK input file: polydisperse stratified streaming instability in a wide box,
# (Lx, Ly, Lz) = (1.6H, 1.6H, 0.2H) -- the NHFP 2027 proposal run (box of Yang & Johansen
# 2014's widest models, which hold several filaments) -- here at the LOW resolution of
# 320/H (512 x 512 x 64 cells) as a pilot.  The proposal resolutions are
#   1280/H: mesh/nx1=2048 mesh/nx2=2048 mesh/nx3=256  (1.07e9 cells; 64 GPUs on Vista gh)
#   2560/H: mesh/nx1=4096 mesh/nx2=4096 mesh/nx3=512  (8.6e9 cells; > 2^31-1 particles at
#           1 per cell, see streaming_strat.cpp)
#
# Units Omega = c_s = rho0 = 1, so H = 1 and P = 2 pi.  Pi = 0.05 (the standard SI
# benchmark value): the gas feels a_x = 2 Omega Pi c_s = 0.1 (<hydro_srcterms>/const_accel);
# gas and particles feel -Omega^2 z (<shearing_box>/stratified = true).  Four species,
# St = 0.01, 0.03, 0.1, 0.3, equal mass: Z = Sigma_p/Sigma_g = 0.04 in total with
# Sigma_g = sqrt(2 pi) H rho0 (full disk column), Z_s = 0.01 per species, a dust/gas mass
# ratio of 0.502 inside the box.  At 45 au in the MMSN (Sigma_g = 5.63 g/cm^2) these
# Stokes numbers are grain radii of 0.21, 0.64, 2.1, 6.4 mm for 1.675 g/cm^3 (DSHARP) grains.
#
# Initial condition (Athena-C par_strat3d ipert = 1 style, as the Godines+26 10 au input):
# particles in a Gaussian layer of width 0.02 H, uniform in (x,y), at rest (Keplerian); gas
# in hydrostatic equilibrium at the dust-free equilibrium u_y = -Pi c_s.  Periodic z for gas
# and particles, shear-periodic x.  Numerics: Roe (HLLE suppresses the stratified SI at low
# resolution), WENO-Z, imex2+, CFL 0.3, TSC, no self-gravity.
#
# MeshBlocks of 64^3: 8 x 8 x 1 at 320/H, every block holds a full vertical column, so the
# settled layer loads all blocks evenly.
#
# Vista (gh): scripts/cluster/si_strat_gpu.slurm (4 GPUs, restart chaining with CONT=1).

<comment>
problem   = NHFP pilot: (1.6H)^2 x 0.2H, 320/H, 4 species St 0.01-0.3, Z = 0.04, Pi = 0.05

<job>
basename  = nhfp

<mesh>
nghost    = 3                # wenoz needs 3
nx1       = 512              # radial: 1.6 H at 320/H
x1min     = -0.8
x1max     = 0.8
ix1_bc    = shear_periodic
ox1_bc    = shear_periodic
nx2       = 512              # azimuthal: 1.6 H
x2min     = -0.8
x2max     = 0.8
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 64               # vertical: 0.2 H
x3min     = -0.1
x3max     = 0.1
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64               # 8 x 8 x 1 = 64 MeshBlocks
nx2       = 64
nx3       = 64

<time>
evolution  = dynamic
integrator = imex2+          # required by the dust module's IMEX drag
cfl_number = 0.3             # 3D shearing-box hydro rule
nlim       = -1
tlim       = 628.3185307179586    # 100 P
ndiag      = 10000

<hydro>
eos         = isothermal
iso_sound_speed = 1.0
reconstruct = wenoz
rsolver     = roe            # not hlle (see si_strat3d_tests.pdf)

<hydro_srcterms>
const_accel     = true       # radial pressure-gradient mimic, gas only
const_accel_val = 0.1        # = 2*omega0*etavk
const_accel_dir = 1

<shearing_box>
qshear    = 1.5
omega0    = 1.0
stratified = true            # -Omega^2 z on gas and particles

<particles>
particle_type = dust
pusher        = imex_dust
ppc           = 1.0          # 16.8M particles at 320/H, 4.2M per species

<dust>
coupling      = imex
shear_fold    = true
shear_remap   = plm
nspecies      = 4
taus_1        = 0.01
taus_2        = 0.03
taus_3        = 0.1
taus_4        = 0.3
back_reaction = true
deposit       = tsc
gamma_switch  = false
dt_cfl        = 0.5
dt_transport  = relative
dt_block_safety = 0.5
drag_solver   = local        # required with shear-periodic x1

<problem>
pgen_name   = streaming_strat
rho0        = 1.0            # midplane gas density
etavk       = 0.05           # Pi c_s
dust_Z      = 0.04           # Sigma_p/Sigma_g, split evenly over the 4 species
dust_hz     = 0.02           # Gaussian initial layer, in H
gas_vy0     = -0.05          # dust-free equilibrium (-etavk)
random_seed = 1

<output1>
file_type  = hst
dt         = 0.06283185307179586   # 0.01 P
data_format = %.14e

<output2>
file_type  = phst                  # max PM dust density, per-species scale heights
dt         = 0.06283185307179586   # 0.01 P

<output3>
file_type  = vtk                   # particle-mesh dust density (all species), 67 MB each
variable   = dust_dpm
dt         = 3.141592653589793     # 0.5 P

<output4>
file_type  = pvtk                  # all particles (positions, species, velocities), ~0.6 GB each
variable   = prtcl_all
dt         = 12.566370614359172    # 2 P

<output5>
file_type  = vtk                   # gas primitives
variable   = hydro_w
dt         = 31.41592653589793     # 5 P

<output6>
file_type  = rst
dt         = 62.83185307179586     # 10 P
