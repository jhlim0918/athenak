# AthenaK input file: SMALL stratified gravito-turbulence box with density-triggered
# ADAPTIVE refinement — the Phase 3 AMR + slab-gravity smoke/validation test (not an
# SC14 production configuration; the 16H x 16H box is too small for converged
# statistics).  Overdense clumps (rho > value_max) refine to level 1; the
# MeshRefinement slab-z policy keeps the x3-face block rows at root level
# automatically (never refined, graded cap), which the multigrid slab boundary
# requires.  Watch for: no CheckSlabBlockLevels fatal after remeshes, finite
# evolution through the cooling collapse, refined blocks confined to |z| < 2H.
# NOTE: the box must provide at least 4 MeshBlock columns in x1 -- the shear-periodic
# refinement policy never refines x1-face blocks, so a 2-column box cannot refine
# anywhere (observed in the first version of this test).

<comment>
problem   = stratified gravito-turbulence, adaptive refinement (Phase 3 test)

<job>
basename  = GravitoTurbAMR

<mesh>
nghost    = 4         # AMR requires even nghost
nx1       = 64        # Number of cells in X1-direction
x1min     = -8.0      # minimum value of X1
x1max     = 8.0       # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 64        # Number of cells in X2-direction
x2min     = -8.0      # minimum value of X2
x2max     = 8.0       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 48        # Number of cells in X3-direction
x3min     = -6.0      # minimum value of X3
x3max     = 6.0       # maximum value of X3
ix3_bc    = diode     # no-inflow outflow
ox3_bc    = diode

<meshblock>
nx1       = 16        # cubic MeshBlocks (multigrid requirement)
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement = adaptive
max_nmb_per_rank = 512
num_levels = 2
refinement_interval = 5

<amr_criterion0>
method    = min_max
variable  = hydro_w_d
value_max = 2.0       # refine blocks containing rho > 2 rho0 (collapse clumps)

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 30.0     # through the cooling collapse and clump formation
ndiag      = 500      # cycles between diagnostic output

<hydro>
eos         = ideal   # EOS type
gamma       = 1.6666666666666667
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
dfloor      = 1.0e-4  # density floor (SC14: 1e-4 rho0)
pfloor      = 1.0e-10 # pressure floor (halo shocks)

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency
stratified = true     # vertical tidal gravity -Omega^2 z
orbital_advection = true

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 4.25231   # = 4*pi*0.3384 (SC14 fiducial G)
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
mg_remap  = ppmx      # shear ghost + slab plane remap order
threshold = -1.0      # fixed-iteration mode (stagnation exit can under-iterate on
niteration = 12       # refined shearing meshes; see implementation doc sec. limits)
full_multigrid = true
fmg_ncycle = 1
show_defect = 0

<hydro_srcterms>
self_gravity = true
beta_cooling = true
bcool_beta   = 10.0   # beta = Omega*t_cool

<problem>
pgen_name = gravito_turb
user_hist = true
rho0      = 1.0
cs0       = 2.12625   # midplane sound speed (Q0 = 1 fiducial)
dfloor_ic = 1.0e-4    # initial-condition halo floor
pert_amp  = 0.1       # velocity perturbations up to pert_amp*cs0 ...
pert_zmax = 2.0       # ... for |z| < pert_zmax
pert_seed = 1

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = hydro_w
dt        = 5.0
