# AthenaK input file: the gravito-turbulent box of Baehr, Zhu & Yang (2022, ApJ 933, 100)
# in SC14 code units (rho0 = Omega = 1, the SC14 half-thickness H = 1, cs0 = 2.126 at
# Q0 = 1).  STAGE 1 of the two-stage dust runs: the gas alone, run to the saturated
# gravito-turbulent state (their averaging starts at t = 50/Omega); stage 2 restarts from
# a dump of this run with inputs/shearing_box/gravito_turb_baehr_dust.athinput, which
# inserts the particles.  Their Table 1: 512^2 x 256 cells, Lx = Ly = (80/pi) H_g,
# Lz = (40/pi) H_g with H_g = cs0/Omega (cubic cells, 0.05 H_g), beta = 10, Q0 = 1.02,
# gamma = 5/3, cooling toward the initial temperature (irradiation floor).  Here
# H_g = 1.02 x 2.12625 = 2.16878, so Lx = Ly = 55.23, Lz = 27.61, dx = 0.1079.
#   the box is 21x the cells of the SC14 standard run: see scripts/cluster/gt_baehr_*.slurm
#   small-box mechanics test: mesh/nx1=64 mesh/nx2=64 mesh/nx3=32 (dx = 0.86)

<comment>
problem   = Baehr+22 gravito-turbulence, stage 1 (gas only, beta = 10, Q0 = 1.02)

<job>
basename  = gtb

<mesh>
nghost    = 3         # Number of ghost cells
nx1       = 512       # Number of cells in X1-direction
x1min     = -27.6151  # minimum value of X1: Lx = (80/pi) H_g, H_g = 2.16878
x1max     = 27.6151   # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 512       # Number of cells in X2-direction
x2min     = -27.6151  # minimum value of X2
x2max     = 27.6151   # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 256       # Number of cells in X3-direction
x3min     = -13.80755 # minimum value of X3: Lz = (40/pi) H_g
x3max     = 13.80755  # maximum value of X3
ix3_bc    = diode     # no-inflow outflow (plain outflow feeds a gravity-driven
ox3_bc    = diode     # inflow runaway through the z faces; SC14's "outflow" intent)

<meshblock>
nx1       = 16        # cubic MeshBlocks (multigrid requirement)
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 50.0     # time limit: Baehr+22 average from t = 50/Omega (saturated)
ndiag      = 100      # cycles between diagnostic output

<hydro>
eos         = ideal   # EOS type
gamma       = 1.6666666666666667
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
dfloor      = 1.0e-4  # density floor (SC14: 1e-4 rho0)
pfloor      = 1.0e-10 # pressure floor (halo shocks; SC14 used Athena's default floors)

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency
stratified = true     # vertical tidal gravity -Omega^2 z
orbital_advection = true

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 4.25231   # = 4*pi*0.3384 (SC14 fiducial G)
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
vert_bc   = open      # FFT solver only (solver=fft cross-checks; ignored by MG)
mg_remap  = ppmx      # shear ghost + slab plane remap order
threshold = -1.0      # FIXED iteration count, not the stagnation rule: 6
niteration = 6        # warm-started V-cycles reach defect ~5e-7 (far below the
                      # ~1e-4 discretization error) at ~1/3 the cost; the
                      # validated 2026-08 b10 run used threshold=0.0 -- results
                      # are insensitive (solver tolerance << physics)
full_multigrid = false  # iterative mode: warm-start from the previous potential
show_defect = 0

<hydro_srcterms>
self_gravity = true
beta_cooling = true
bcool_beta   = 10.0   # beta = Omega*t_cool
bcool_cs2_floor = 4.70361  # irradiation floor: cool toward the initial T (cs0^2)
thermal_cooling = false  # SC14 "b" runs: t_cool = tcool_b*(rho/P)^3 (set
tcool_b      = 200.0     # beta_cooling=false when enabling)
cool_eps     = 0.02      # dt <= cool_eps*t_cool

<problem>
pgen_name = gravito_turb
user_hist = true
rho0      = 1.0
cs0       = 2.16878   # midplane sound speed: Q0 = 1.02 (Q scales with cs0)
dfloor_ic = 1.0e-4    # initial-condition halo floor
pert_amp  = 0.1       # velocity perturbations up to pert_amp*cs0 ...
pert_zmax = 4.34      # ... for |z| < 2 H_g
pert_seed = 1

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = hydro_w
dt        = 10.0

<output3>
file_type = bin
variable  = grav_phi
dt        = 10.0

<output4>
file_type = rst
dt        = 10.0      # stage 2 restarts from the t = 50 dump
