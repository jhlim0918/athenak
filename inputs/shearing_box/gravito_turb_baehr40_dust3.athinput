# AthenaK input file: STAGE 2 of the 40 cells/H_g Baehr box (gravito_turb_baehr40.athinput)
# with THREE dust species -- the ADD-ON read on top of the stage-1 restart at t = 150:
#     athena -r <gtb40 stage1>/rst/<t = 150 dump> -i inputs/shearing_box/gravito_turb_baehr40_dust3.athinput
# The 40/H counterpart of gravito_turb_baehr_dust3.athinput (the gtb_BR_3sp run): St = 0.01,
# 0.1, 1 interleaved in every cell, hybrid coupling, Z = 0.04 (0.0133 per species), same
# outputs.  The particle count is set by the midplane, not by the 20/H ppc: ~1 particle per
# cell there for St = 0.1.  Layer widths measured at 20/H (gtb_BR_3sp, t = 180-200:
# sig_z = 1.04, 0.65, 0.24 for St = 0.01, 0.1, 1 -- 0.66x the Hp = H_g sqrt(alpha/(alpha+St))
# of alpha_z = 0.027, the self-gravitating disk's Omega_z ~ 2.1 Omega squeezing them) put
# the midplane at ~0.55, 1, 2.7 particles per cell for St = 0.01, 0.1, 1 with 3.2e7 per
# species (9.7e7 in total in the 1024^2 x 512 box; the 20/H ppc would give 0.2, 0.4, 1).
# Blocks merge over the dump's input; restart_insert makes the generator place the layer
# (Gaussian in z with the gas width H_g, at rest in the shearing frame).  With
# back_reaction = false the species do not interact and the run is three single-species
# experiments at once; with it on, the total Z is what the gas feels.
# Memory: ~850 B per ghost-padded cell with dust (gtb_bench_gh4: 36 GB per GH200 for
# 4.4e7 padded cells) -> 9.0e8 padded cells here, ~48 GB per GPU on 16 GH200s; NOT 8.
#     RST=<t = 150 dump> ADDON=$HOME/athenak-multigrid/inputs/shearing_box/gravito_turb_baehr40_dust3.athinput \
#       TLIM=200 sbatch -J gtb40_3sp -N 16 -n 16 $HOME/athenak-multigrid/scripts/cluster/gt_bc16_stage2_gpu.slurm
# Optional radial pressure gradient (dust drift), off here as in the 20/H runs:
#     hydro_srcterms/const_accel=true   (const_accel_val = 2*1*0.05*cs0 = 0.2126, Pi = 0.05)
# the insertion then shifts the restarted gas by -eta v_K (problem/gas_vy_shift = auto).
# To CONTINUE from one of this run's own dumps add particles/restart_insert=false.

<time>
tlim       = 200.0    # 50 more orbits^-1 of dust evolution, from the t = 150 dump

<particles>
particle_type = dust
pusher        = imex_dust
ppc           = 0.18      # 3 x 0.06: 3.2e7 per species, ~1 per midplane cell for St = 0.1
restart_insert = true     # the stage-1 dump has no particles: insert them

<dust>
coupling      = hybrid    # PC2 under rk2 while the drag is mild, split backward-Euler
                          # when a cell is stiff (chi = dt*eps/t_s > 0.5): the St = 0.01
                          # particles in the floor-density halo cannot be taken by plain pc2
nspecies      = 3
taus_1        = 0.01      # St = 0.01: well coupled, stirred with the gas
taus_2        = 0.1
taus_3        = 1.0       # St = 1: Baehr's "L", the spiral-trapped size
back_reaction = true      # override dust/back_reaction=false on the command line for noBR
deposit       = tsc
gravity       = true      # dust in the Poisson source and subject to -grad(phi)
gravity_source = true
gravity_force  = true
dt_cfl        = 0.5
dt_transport  = relative
dt_block_safety = 0.5
shear_fold    = true
shear_remap   = plm
stopping_time_mode = species_fixed

<hydro_srcterms>
const_accel     = false   # radial pressure-gradient mimic on the gas: a_x = 2 Omega eta v_K
const_accel_dir = 1
const_accel_val = 0.2126  # eta v_K = 0.05 cs0 (Pi = 0.05)

<problem>
dust_Z    = 0.04          # total dust-to-gas ratio (default split: dust_Z/nspecies each)
dust_Z_1  = 0.01333333333333333   # per-species ratios -- these OVERRIDE the split above,
dust_Z_2  = 0.01333333333333333   # so all four move together
dust_Z_3  = 0.01333333333333333
dust_hz   = 2.16878       # Gaussian half-width of the inserted layer = H_g
dust_seed = 7
gas_vy_shift = auto       # -a_x/(2 Omega) when const_accel is on (no epicycle); or a number

<output5>
file_type = bin
variable  = dust_dpm
dt        = 5.0

<output6>
file_type = pvtk
variable  = prtcl_all
dt        = 5.0

<output7>
file_type = phst      # particle history: momenta, KE, escaped mass, max dust density,
dt        = 0.25      # per-species means and dispersions (sig_z = H_d)
