# AthenaK input file: the 16H proof-of-concept box at 80 cells per H_g with the dust
# present from t = 0 -- a PILOT.  A COMPLETE input, run fresh (AthenaK takes only one -i
# on a fresh start; a second one replaces rather than merges it, so this cannot be an
# add-on the way the stage-2 layers are).  Generated from gravito_turb_bc16.athinput --
# if that file changes, regenerate rather than hand-editing both.
#     mkdir -p $SCRATCH/gt16/pilot && cd $SCRATCH/gt16/pilot \
#       && BIN=$HOME/athenak-multigrid/build-gpu/src/athena \
#          INPUT=$HOME/athenak-multigrid/inputs/shearing_box/gravito_turb_bc16_pilot.athinput \
#          sbatch -t 48:00:00 $HOME/athenak-multigrid/scripts/cluster/gt_bc16_stage1_gpu.slurm
#
# WHAT THIS IS NOT.  The production experiment is two-stage: gas to saturation, then the
# particles into a state that is already gravito-turbulent.  Here they go into the
# LAMINAR initial condition, which changes their history twice over.  The grains settle
# on ~1/(Omega*St) -- one orbit for St = 1 -- while gravito-turbulence needs tens of
# orbits to appear, so the layer first collapses to a thickness no turbulence set and
# reaches a midplane dust-to-gas ratio far above the saturated one; it then rides out the
# first gravitational-instability burst, which overshoots.  H_d, rho_d,max and the
# clumping measured here are NOT the two-stage numbers and should not be quoted as them.
#
# WHAT IT IS FOR.  It exercises the whole coupled stack -- particles, back-reaction, dust
# self-gravity, the multigrid, managed memory and MPI -- at production resolution in one
# job, hours after launch instead of after a stage 1.  Nothing else tests that
# combination at this scale.  Run it ALONGSIDE stage 1, not instead of it.
#
# Mass is split by size as MRN would (dn/da ~ a^-3.5 with St ~ a gives mass ~ St^0.5), so
# the St = 1 grains carry 71% of Z while the particle COUNT stays equal per species.
<comment>
problem   = 16H gravito-turbulent box at 80 cells/H, stage 1 (gas only, beta = 10)

<job>
basename  = gt16

<mesh>
nghost    = 3         # 3, not 4: the multigrid force does not converge within a few
                      # cells of a level jump, so this box is run on a uniform grid and
                      # has no use for the even ghost count SMR/AMR would require.  Three
                      # is 14% fewer cells per block than four, and all the reconstruction
                      # here (plm) asks for is two.
nx1       = 1280      # 80 cells per H_g
x1min     = -17.35024 # Lx = 16 H_g, H_g = 2.16878
x1max     = 17.35024
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 1280
x2min     = -17.35024 # Ly = 16 H_g
x2max     = 17.35024
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 512
x3min     = -6.940096 # Lz = 6.4 H_g (BC19 use 6 H; 512 cells keeps the cells cubic)
x3max     = 6.940096
ix3_bc    = hse_outflow  # outflow with hydrostatic ghost density (BC19); diode leaks
ox3_bc    = hse_outflow  # mass in through the z faces once the halo lifts off the floor

<meshblock>
nx1       = 32        # cubic MeshBlocks (multigrid requirement); 40 x 40 x 16 of them
nx2       = 32
nx3       = 32

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 30.0     # the first burst and a few orbits after it (pilot)
ndiag      = 100      # cycles between diagnostic output

<hydro>
eos         = ideal   # EOS type
gamma       = 1.6666666666666667
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
dfloor      = 1.0e-4  # density floor (SC14: 1e-4 rho0)
pfloor      = 1.0e-10 # pressure floor (halo shocks; SC14 used Athena's default floors)

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency
stratified = true     # vertical tidal gravity -Omega^2 z
orbital_advection = true

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 4.25231   # = 4*pi*0.3384 (SC14 fiducial G)
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
vert_bc   = open      # FFT solver only (solver=fft cross-checks; ignored by MG)
mg_remap  = ppmx      # shear ghost + slab plane remap order
threshold = -1.0      # FIXED iteration count, not the stagnation rule: 6
niteration = 3        # warm-started V-cycles: 3 reproduce the converged Jeans growth
                      # rate to 3e-6 (2: 4e-5, 1: 1e-3); on a GPU each V-cycle is ~0.03 s
                      # against a fixed ~0.2 s per solve, so more buy nothing (was 6:
                      # ~1e-4 discretization error) at ~1/3 the cost; the
                      # validated 2026-08 b10 run used threshold=0.0 -- results
                      # are insensitive (solver tolerance << physics)
full_multigrid = false  # iterative mode: warm-start from the previous potential
show_defect = 0

<hydro_srcterms>
self_gravity = true
beta_cooling = true
bcool_beta   = 10.0   # beta = Omega*t_cool
bcool_cs2_floor = 4.70361  # irradiation floor at the initial temperature (cs0^2).  BC19 use
                         # pure beta cooling (floor 0), and in THIS box that is a trap: with
                         # Lz = 6.4 H_g there is no room for the overshoot.  The gas cools to
                         # Q = 0.6 by t ~ 20, bursts at alpha = 0.22 (5x Gammie), and the burst
                         # drives 16% of the mass out through the z faces -- Sigma never
                         # recovers, Q climbs past 2.7 and the instability switches off
                         # (validation/run/gt16_gpu_stage1, t = 40).  With the floor the disk
                         # never overshoots: mild burst, alpha ~ 0.015, Q ~ 1.2, mass conserved
                         # to ~0.1%, as the Baehr stage 1 did.  Set 0.0 only with a taller box.
thermal_cooling = false  # SC14 "b" runs: t_cool = tcool_b*(rho/P)^3 (set
tcool_b      = 200.0     # beta_cooling=false when enabling)
cool_eps     = 0.02      # dt <= cool_eps*t_cool
const_accel     = true   # radial pressure gradient on the gas, a_x = 2 Omega eta v_K,
const_accel_dir = 1      # Pi = eta v_K / cs0 = 0.1: eta*r = 0.1 H_g = 8 cells, so the
const_accel_val = 0.43376 # fastest streaming mode (~2 pi eta r) spans ~50 cells

<problem>
dust_Z    = 0.02          # total; the per-species values below OVERRIDE the even split
dust_Z_1  = 0.001412202   # MRN weights, St^0.5 normalized:  7.1%
dust_Z_2  = 0.004465776   #                                 22.3%
dust_Z_3  = 0.014122022   #                                 70.6%
dust_hz   = 2.16878       # initial layer width = H_g
dust_seed = 7
gas_vy_shift = auto       # -eta v_K, so the pressure gradient launches no epicycle
pgen_name = gravito_turb
user_hist = true
rho0      = 1.0
cs0       = 2.16878   # midplane sound speed: Q0 = 1.02 (Q scales with cs0)
dfloor_ic = 1.0e-4    # initial-condition halo floor
pert_amp  = 0.1       # velocity perturbations up to pert_amp*cs0 ...
pert_zmax = 4.34      # ... for |z| < 2 H_g
pert_seed = 1

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = hydro_w
dt        = 5.0

<output3>
file_type = bin
variable  = grav_phi
dt        = 5.0

<output4>
file_type = rst
dt        = 10.0      # stage 2 restarts from the dump after the first burst

<particles>
particle_type = dust
pusher        = imex_dust
ppc           = 0.3       # 0.1 per species: 8.4e7 each, 2.5e8 in the 1280^2 x 512 box
insert_at_t0  = true      # place them in the initial state; NOT restart_insert

<dust>
coupling      = hybrid    # the St = 0.01 grains are stiff where the gas is at the floor
nspecies      = 3
taus_1        = 0.01
taus_2        = 0.1
taus_3        = 1.0
back_reaction = true
deposit       = tsc
gravity       = true
gravity_source = true
gravity_force  = true
dt_cfl        = 0.5
dt_transport  = relative
dt_block_safety = 0.5
shear_fold    = true
shear_remap   = plm
stopping_time_mode = species_fixed

<output5>
file_type = bin
variable  = dust_dpm
dt        = 2.0

<output6>
file_type = pvtk
variable  = prtcl_all
dt        = 2.0

<output7>
file_type = phst
dt        = 0.1
