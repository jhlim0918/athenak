# AthenaK input file: gravito-turbulent stratified shearing box, the standard
# beta = Omega*t_cool = 10 run of Shi & Chiang (2014), ApJ 789, 34 (their tc=10).
#
# Physics: 3D hydro shearing box (q = 3/2, Omega = 1) with linearized vertical tidal
# gravity, self-gravity (multigrid: shear-periodic x1 + periodic x2 + slab-open x3),
# and constant-beta cooling dU/dt = -U*Omega/beta.  Code units rho0 = H = Omega = 1
# with SC14's fiducial constants: gamma = 5/3, Toomre Q0 = 1 initial equilibrium,
# cs(0) = 2.12625, G = 0.3384 (four_pi_G = 4.25231).
#
# Box [-32H,32H]^2 x [-6H,6H] at 256 x 256 x 48 (4 cells/H, SC14 standard
# resolution), 16^3 cubic MeshBlocks (multigrid requirement; the middle z-row of
# blocks spans exactly |z| < 2H for optional midplane refinement studies).
#
# Expected behavior (SC14 sec. 3.1.1, Fig. 2): violent cooling collapse for the
# first ~10/Omega, vertical rebound with ~10% mass loss through the z boundaries,
# relaxation by t ~ 50/Omega into steady gravito-turbulence with Q ~ 1.33,
# alpha_grav ~ 3.9e-2, alpha_Reynolds ~ 1.9e-2 (eq. 19), alpha' ~ 4.2e-2 ~
# 4/(9*gamma*(gamma-1))/beta (eq. 21), rms dv ~ 1.8 H*Omega.
#
# History columns (user_hist, see src/pgen/fluids/gravito_turb.cpp):
#   mass, rho_cs, rho_wgrv, rho_wrey, rho_prs, wgrv, wrey, rho_cs2, rho_dv2, eint
#   Q      = (rho_cs/mass)*omega0/(pi*G*mass/(Lx*Ly))
#   alpha  = (rho_wgrv + rho_wrey)/rho_prs          (SC14 eq. 19)
#   alpha' = (2/(3*gamma))*(wgrv + wrey)/rho_cs2    (SC14 eq. 20)
#   rms dv = sqrt(rho_dv2/mass)

<comment>
problem   = SC14 gravito-turbulence (beta = 10)

<job>
basename  = GravitoTurb

<mesh>
nghost    = 3         # Number of ghost cells
nx1       = 256       # Number of cells in X1-direction
x1min     = -32.0     # minimum value of X1
x1max     = 32.0      # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 256       # Number of cells in X2-direction
x2min     = -32.0     # minimum value of X2
x2max     = 32.0      # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 48        # Number of cells in X3-direction
x3min     = -6.0      # minimum value of X3
x3max     = 6.0       # maximum value of X3
ix3_bc    = diode     # no-inflow outflow (plain outflow feeds a gravity-driven
ox3_bc    = diode     # inflow runaway through the z faces; SC14's "outflow" intent)

<meshblock>
nx1       = 16        # cubic MeshBlocks (multigrid requirement)
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 300.0    # time limit (300/Omega, SC14 standard duration)
ndiag      = 100      # cycles between diagnostic output

<hydro>
eos         = ideal   # EOS type
gamma       = 1.6666666666666667
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
dfloor      = 1.0e-4  # density floor (SC14: 1e-4 rho0)
pfloor      = 1.0e-10 # pressure floor (halo shocks; SC14 used Athena's default floors)

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency
stratified = true     # vertical tidal gravity -Omega^2 z
orbital_advection = true

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 4.25231   # = 4*pi*0.3384 (SC14 fiducial G)
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
vert_bc   = open      # FFT solver only (solver=fft cross-checks; ignored by MG)
mg_remap  = ppmx      # shear ghost + slab plane remap order
threshold = 0.0       # automatic convergence control
niteration = 20
full_multigrid = false  # iterative mode: warm-start from the previous potential
show_defect = 0

<hydro_srcterms>
self_gravity = true
beta_cooling = true
bcool_beta   = 10.0   # beta = Omega*t_cool
thermal_cooling = false  # SC14 "b" runs: t_cool = tcool_b*(rho/P)^3 (set
tcool_b      = 200.0     # beta_cooling=false when enabling)
cool_eps     = 0.02      # dt <= cool_eps*t_cool

<problem>
pgen_name = gravito_turb
user_hist = true
rho0      = 1.0
cs0       = 2.12625   # midplane sound speed (Q0 = 1 fiducial)
dfloor_ic = 1.0e-4    # initial-condition halo floor
pert_amp  = 0.1       # velocity perturbations up to pert_amp*cs0 ...
pert_zmax = 2.0       # ... for |z| < pert_zmax
pert_seed = 1

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = hydro_w
dt        = 10.0

<output3>
file_type = bin
variable  = grav_phi
dt        = 10.0

<output4>
file_type = rst
dt        = 50.0
