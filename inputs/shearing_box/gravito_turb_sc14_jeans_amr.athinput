# AthenaK input file: the standard-resolution SC14 beta = 10 box (Shi & Chiang 2014,
# ApJ 789, 34, their tc=10) on a MULTI-LEVEL adaptive mesh, from a cold start.
#
# Purpose: the fragmentation boundary.  From the same cold start the uniform run at
# 4 cells/H does not fragment while the one at 8 cells/H keeps one fragment of the
# first collapse (both z boundaries).  This run starts from the 4 cells/H root grid and
# lets a Jeans-number criterion refine the collapsing gas, so the question "does the
# gas fragment at beta = 10 (and at longer cooling times) once the collapse is
# resolved?" is asked without paying for a uniformly fine box.
#
# Differences from gravito_turb_sc14.athinput, and why:
#  * 8^3 MeshBlocks (32 x 32 x 6 root blocks), not 16^3.  The slab-open x3 policy keeps
#    the blocks on the z faces at root level and grades the levels away from them; with
#    16^3 blocks the box has 3 root blocks in z and the graded cap is empty above ONE
#    refinement level.  With 6 it cascades without limit inside |z| < 2H (level 1 is
#    allowed for |z| < 4H, level 2 for |z| < 3H, level 3 for |z| < 2.5H).  The same
#    cap in x1 keeps the finest levels ~4H away from the shear-periodic faces.
#  * nghost = 4 (refinement needs an even number).
#  * hse_outflow z boundaries (the diode leaks mass inward once the halo lifts off the
#    floor).
#  * <amr_criterion0> method = user: the Jeans criterion of the gravito_turb pgen.
#
# Cost rules measured on this configuration (2026-09-28):
#  * max_nmb_per_rank sizes every array, and whole-array operations (the RK register
#    copy among them) run over the ALLOCATED blocks: on an unrefined mesh a cap of 5x
#    the blocks in use costs 1.4x per cycle and 40x costs 7x.  Keep the cap within
#    ~1.5x of the peak block count per rank and raise it at a restart if the run stops
#    on "exceeds <mesh_refinement>/max_nmb_per_rank".
#  * 8^3 blocks at nghost = 4 cost 1.6x the 16^3 uniform run per cycle, unrefined.
#  * There is no sub-cycling: every level halves dt for the whole mesh.
#
# Same physics, units and history columns as gravito_turb_sc14.athinput.

<comment>
problem   = SC14 gravito-turbulence (beta = 10), Jeans-refined adaptive mesh

<job>
basename  = GravitoTurbAMR

<mesh>
nghost    = 4         # even, for mesh refinement
nx1       = 256       # Number of cells in X1-direction
x1min     = -32.0     # minimum value of X1
x1max     = 32.0      # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 256       # Number of cells in X2-direction
x2min     = -32.0     # minimum value of X2
x2max     = 32.0      # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 48        # Number of cells in X3-direction
x3min     = -6.0      # minimum value of X3
x3max     = 6.0       # maximum value of X3
ix3_bc    = hse_outflow  # hydrostatic extrapolation, no inflow
ox3_bc    = hse_outflow

<meshblock>
nx1       = 8         # cubic, power of two (multigrid); 6 root blocks in z so that
nx2       = 8         # the slab-open graded cap admits more than one level
nx3       = 8

<mesh_refinement>
refinement = adaptive
num_levels = 3        # root + 2: 4 -> 8 -> 16 cells/H.  4 gives 32 cells/H at half
                      # the timestep again
max_nmb_per_rank = 112 # at 512 ranks: room for 57344 blocks.  6144 unrefined; the
                      # first collapse peaks near 45000 at t ~ 20 (scaled from the
                      # 16H test box); ~10000 with one fragment, where 32 suffices
ncycle_check = 10     # cycles between checks of the criterion
refinement_interval = 5

<amr_criterion0>
method    = user      # GravitoTurbRefinement: Jeans number, <problem>/amr_*

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.3      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1       # cycle limit
tlim       = 300.0    # time limit (300/Omega, SC14 standard duration)
ndiag      = 100      # cycles between diagnostic output

<hydro>
eos         = ideal   # EOS type
gamma       = 1.6666666666666667
reconstruct = plm     # spatial reconstruction method
rsolver     = hllc    # Riemann-solver to be used
dfloor      = 1.0e-4  # density floor (SC14: 1e-4 rho0)
pfloor      = 1.0e-10 # pressure floor (halo shocks; SC14 used Athena's default floors)

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency
stratified = true     # vertical tidal gravity -Omega^2 z
orbital_advection = true

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 4.25231   # = 4*pi*0.3384 (SC14 fiducial G)
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
mg_remap  = ppmx      # shear ghost + slab plane remap order
threshold = 2.0e-5    # TOLERANCE on the defect norm, not a fixed count: the first
niteration = 6        # solve after every remesh (and restart) starts cold, and 6
                      # V-cycles leave it at 2e-2..0.2 against 2e-5 for a warm one.
                      # The tolerance takes 6-7 V-cycles warm and 11-12 cold (measured
                      # at t = 15 and 20).  niteration is ignored while threshold >= 0;
                      # the solver stops the run if 40 V-cycles do not reach it
full_multigrid = false  # iterative mode: warm-start from the previous potential
show_defect = 0

<hydro_srcterms>
self_gravity = true
beta_cooling = true
bcool_beta   = 10.0   # beta = Omega*t_cool
thermal_cooling = false
tcool_b      = 200.0
cool_eps     = 0.02      # dt <= cool_eps*t_cool

<problem>
pgen_name = gravito_turb
user_hist = true
rho0      = 1.0
cs0       = 2.12625   # midplane sound speed (Q0 = 1 fiducial)
dfloor_ic = 1.0e-4    # initial-condition halo floor
pert_amp  = 0.1       # velocity perturbations up to pert_amp*cs0 ...
pert_zmax = 2.0       # ... for |z| < pert_zmax
pert_seed = 1
amr_njeans = 16.0     # refine a block whose gas has lambda_J < 16 dx.  At the root
                      # spacing the saturated turbulence sits at 19-20 (unrefined) and
                      # the first collapse at 13 (refined from t ~ 10)
amr_njeans_deref = 2.5  # derefine above 16*2.5 = 40 dx (must exceed 2)
amr_rho_min = 2.1165  # density gate: the Roche density 9 Omega^2/(4 pi G).  Halo cells
                      # on the pressure floor have lambda_J < dx at rho ~ 1e-4
amr_cs_min = 1.0      # cs floor inside the gate (gated gas in the archived runs has
                      # cs > 1.27, except isolated cells on the pressure floor)
amr_tstart = 0.0      # > 0 holds the root mesh until then (saturated-state start)

<output1>
file_type = hst
dt        = 0.25

<output2>
file_type = bin
variable  = hydro_w
dt        = 5.0

<output3>
file_type = bin
variable  = grav_phi
dt        = 5.0

<output4>
file_type = rst
dt        = 10.0
