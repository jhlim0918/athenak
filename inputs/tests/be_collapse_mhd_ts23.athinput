# AthenaK input file: collapse of a magnetized cloud, Tomida & Stone (2023) ApJS 266, 7,
# sec. 4.4 (Fig. 12).  be_collapse_mhd.athinput is the Athena++ example (64^3 over +-16,
# njeans 16, omega t_ff 0.03); this one follows the paper.
#
# Cloud: critical Bonnor-Ebert sphere (Tomida 2011 profile) at T = 10 K, density x f = 1.2,
# 10% m = 2 perturbation, M = 1 Msun, R = 8400 au, rho_0 = 1.13e-18 g/cc (BE parameter;
# centre 1.36e-18), solid-body rotation omega t_ff = 0.1 and uniform Bz = 27.4 uG
# (mass-to-flux mu = 3), both along z.  Barotropic EOS (paper eq. 35): isothermal at
# cs = 0.19 km/s below rho_crit = 1e-13 g/cc, gamma = 5/3 above.
# Code units: cs = 4 pi G = 1, l0 = 1302.7 au, t0 = 32503 yr, rho0 = 1.134e-18 g/cc,
# B unit 71.7 uG; cloud radius 6.45, t_ff = 1.76.
#
# Grid: [-10400 au, 10400 au]^3 = +-8 l0, root 128^3, 16^3 MeshBlocks, AMR resolving the
# Jeans length with >= 32 cells (njeans = 32; local sqrt(gamma P/rho) + v_A).  The paper's
# run ends at t = 1.96e5 yr (t = 6.03 here) when rho_c = 1e-8 g/cc (rho_max = 8.8e9 in the
# history) with 9 levels generated (finest 0.326 au); num_levels = 12 keeps the cap out
# of the way.
# Gravity: FMG + 10 V(1,1) cycles every step (no threshold: a threshold overrides
# niteration), isolated BCs from the multipole expansion to hexadecapoles, source masked
# outside the initial cloud radius.  Velocity outside the cloud is held at zero by the
# pgen's barotropic source term (pressure confinement).
# Differences from the paper: integrator rk2 (AthenaK has no vl2).

<job>
basename  = be_collapse

<mesh>
nghost    = 4
nx1       = 128
x1min     = -8.0
x1max     = 8.0
ix1_bc    = outflow
ox1_bc    = outflow

nx2       = 128
x2min     = -8.0
x2max     = 8.0
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 128
x3min     = -8.0
x3max     = 8.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<mesh_refinement>
refinement       = adaptive
max_nmb_per_rank = 512
num_levels       = 12

<amr_criterion0>
method = user

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 6.2
ndiag      = 10

<mhd>
eos         = ideal
gamma       = 1.6666666666666667
reconstruct = plm
rsolver     = hlld

<gravity>
four_pi_G      = 1.0
mg_bc          = multipole
mporder        = 4
auto_mporigin  = true
mask_radius    = 6.45
mask_origin_x1 = 0.0
mask_origin_x2 = 0.0
mask_origin_x3 = 0.0
niteration     = 10
npresmooth     = 1
npostsmooth    = 1
full_multigrid = true
fmg_ncycle     = 1
show_defect    = 0
mg_nghost      = 1

<mhd_srcterms>
self_gravity = true

<problem>
pgen_name   = be_collapse
user_srcs   = true
user_hist   = true
mass        = 1.0
temperature = 10.0
f           = 1.2
njeans      = 32
rhocrit     = 1e-13
amp         = 0.1
mu          = 3.0
omegatff    = 0.1

<output1>
file_type  = hst
dt         = 0.01

<output2>
file_type  = bin
variable   = mhd_w
dt         = 0.25

<output3>
file_type  = bin
variable   = mhd_bcc
dt         = 0.25

<output4>
file_type  = rst
dt         = 0.5
