# AthenaK input file for FFT self-gravity solver discrete-consistency test.
# Triply-periodic box, deterministic multi-mode + blob density; the fft_poisson pgen
# solves for Phi once and prints the residual of the 7-point discrete Poisson equation
# ("# FFT-POISSON ERRORS:"), which should be at machine precision (~1e-13 relative).

<comment>
problem   = FFTPoisson

<job>
basename  = FFTGravityTest   # basename of output filenames, serves as problem ID

<mesh>
nghost    = 3         # Number of ghost cells
nx1       = 64        # Number of cells in X1-direction
x1min     = 0.0       # minimum value of X1
x1max     = 1.0       # maximum value of X1
ix1_bc    = periodic  # Inner-X1 boundary condition flag
ox1_bc    = periodic  # Outer-X1 boundary condition flag

nx2       = 64        # Number of cells in X2-direction
x2min     = 0.0       # minimum value of X2
x2max     = 1.0       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 64        # Number of cells in X3-direction
x3min     = 0.0       # minimum value of X3
x3max     = 1.0       # maximum value of X3
ix3_bc    = periodic  # Inner-X3 boundary condition flag
ox3_bc    = periodic  # Outer-X3 boundary condition flag

<meshblock>
nx1       = 32        # Number of cells in each MeshBlock, X1-dir
nx2       = 32        # Number of cells in each MeshBlock, X2-dir
nx3       = 32        # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.2      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0        # cycle limit (pgen-only test; no evolution)
tlim       = 1.0      # time limit
ndiag      = 1        # cycles between diagnostic output

<hydro>
eos         = isothermal  # EOS type
reconstruct = plm         # spatial reconstruction method
rsolver     = llf         # Riemann-solver to be used
iso_sound_speed = 1.0

<gravity>
solver    = fft       # fft | multigrid
four_pi_G = 1.0
vert_bc   = periodic  # periodic | open

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = fft_poisson   # problem generator name
profile   = modes         # modes | shwave | slab
rho0      = 1.0
amp       = 0.1
blob_amp  = 1.0
time0     = 0.0           # solve time (only matters with a <shearing_box> block)
n1        = 1             # shwave mode numbers (rolled frame)
n2        = 1
n3        = 1
slab_h    = 0.05          # slab scale height (profile = slab)

<output1>
file_type = bin
variable  = hydro_w
dt        = 1.0

<output2>
file_type = bin
variable  = grav_phi
dt        = 1.0
