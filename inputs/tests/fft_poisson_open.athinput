# AthenaK input file for FFT self-gravity solver open-vertical-BC (disk) test.
# Horizontally uniform isothermal slab rho = rho0*sech^2((z-zc)/H) with vacuum vertical
# boundaries (Koyama & Ostriker 2009 two-solve method). The fft_poisson pgen reports:
#  - discrete residual norms; the interior norms (excluding the z boundary layers, whose
#    ghosts are linearly extrapolated) should be at machine precision for this profile
#    (only the kperp=0 column is active, where the screening weights are exact);
#  - "# FFT-POISSON SLAB ERROR": max deviation of phi(z) from the analytic infinite-slab
#    potential 4*pi*G*rho0*H^2*ln(cosh((z-zc)/H)), expected at the ~1% level from the
#    finite vertical box (image-free but truncated slab wings) and O(dz^2) discretization.
# NOTE: keep a single MeshBlock spanning the full mesh (the slab sampler reads block 0).

<comment>
problem   = FFTPoisson (open vertical BC)

<job>
basename  = FFTGravityOpen   # basename of output filenames, serves as problem ID

<mesh>
nghost    = 3         # Number of ghost cells
nx1       = 64        # Number of cells in X1-direction
x1min     = -0.5      # minimum value of X1
x1max     = 0.5       # maximum value of X1
ix1_bc    = periodic  # Inner-X1 boundary condition flag
ox1_bc    = periodic  # Outer-X1 boundary condition flag

nx2       = 64        # Number of cells in X2-direction
x2min     = -0.5      # minimum value of X2
x2max     = 0.5       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 64        # Number of cells in X3-direction
x3min     = -0.5      # minimum value of X3
x3max     = 0.5       # maximum value of X3
ix3_bc    = outflow   # Inner-X3 boundary condition flag
ox3_bc    = outflow   # Outer-X3 boundary condition flag

<meshblock>
nx1       = 64        # Number of cells in each MeshBlock, X1-dir
nx2       = 64        # Number of cells in each MeshBlock, X2-dir
nx3       = 64        # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.2      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0        # cycle limit (pgen-only test; no evolution)
tlim       = 1.0      # time limit
ndiag      = 1        # cycles between diagnostic output

<hydro>
eos         = isothermal  # EOS type
reconstruct = plm         # spatial reconstruction method
rsolver     = llf         # Riemann-solver to be used
iso_sound_speed = 1.0

<gravity>
solver    = fft       # fft | multigrid
four_pi_G = 1.0
vert_bc   = open      # periodic | open

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = fft_poisson   # problem generator name
profile   = slab          # horizontally uniform sech^2 slab (or modes)
rho0      = 1.0
amp       = 0.1
blob_amp  = 1.0
time0     = 0.0
n1        = 1
n2        = 1
n3        = 1
slab_h    = 0.05          # slab scale height H (Lz/20)

<output1>
file_type = bin
variable  = hydro_w
dt        = 1.0

<output2>
file_type = bin
variable  = grav_phi
dt        = 1.0
