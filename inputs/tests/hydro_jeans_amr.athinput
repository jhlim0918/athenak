# AthenaK input file: hydrodynamic Jeans test with adaptive refinement, 2026-11-03.
# hydro_jeans.athinput with a moving refined slab (<problem>/amr_mode = window): every
# MeshBlock whose x1 extent overlaps |x1 - xc(t)| < win_hwidth is refined (to num_levels-1
# levels), all others derefined, with xc(t) = win_x0 + win_speed t wrapped into the box.
# win_speed is set per case by the runner (validation/run/hydro_jeans/hydro_jeans.py) to
# two box crossings per run.  Same meshes as magneto_jeans_amr.athinput.

<comment>
problem   = hydrodynamic Jeans wave (hydro + self-gravity)

<job>
basename  = HydroJeans

<mesh>
nghost    = 4
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 0.125
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 8
x3min     = 0.0
x3max     = 0.125
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement = adaptive
num_levels = 2
refinement_interval = 1
max_nmb_per_rank = 512

<amr_criterion1>
method    = user      # <problem>/amr_mode (window)

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.3
nlim       = -1
tlim       = 1.0
ndiag      = 100

<hydro>
eos         = ideal
gamma       = 1.6666666666666667
iso_sound_speed = 1.0     # used only with eos = isothermal
reconstruct = ppm4
rsolver     = hllc

<gravity>
solver    = multigrid
four_pi_G = 1.0       # replaced from n_jeans
threshold = -1        # fixed V-cycles, as in the magneto-Jeans suite
niteration = 8
full_multigrid = true
show_defect = 0

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = gravity
user_hist = true
rho0      = 1.0
p0        = 0.6       # cs^2 = gamma p0/rho0 = 1
amp       = 1.0e-4    # linear: second-order terms ~1e-8
n_jeans   = 2.0       # lambda / lambda_Jeans (> 1: unstable)
wave_dir  = x1
amr_mode  = window    # moving refined slab
win_x0    = 0.5
win_hwidth = 0.125   # two root blocks wide
win_speed = 0.0       # set per case

<output1>
file_type  = hst
dt         = 0.01
