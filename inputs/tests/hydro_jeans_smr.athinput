# AthenaK input file: hydrodynamic Jeans test on a statically refined mesh, 2026-11-03.
# hydro_jeans.athinput with one refined slab, x1 in [0.25, 0.5) at level 1 (two root
# blocks: 128 cells per wavelength there, 64 elsewhere), so the wave crosses two
# fine/coarse interfaces normal to k.  A second level inside it: add refined_region2 and
# num_levels = 3 via a patched copy (validation/run/hydro_jeans/hydro_jeans.py).  For the
# 3-D oblique wave (wave_dir = oblique in a 1 x 1/2 x 1/2 box) the runner moves the region
# to a central block of the box.  Same meshes as magneto_jeans_smr.athinput.

<comment>
problem   = hydrodynamic Jeans wave (hydro + self-gravity)

<job>
basename  = HydroJeans

<mesh>
nghost    = 4
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 8
x2min     = 0.0
x2max     = 0.125
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 8
x3min     = 0.0
x3max     = 0.125
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement = static
num_levels = 2

<refined_region1>
level     = 1
x1min     = 0.25
x1max     = 0.5
x2min     = 0.0
x2max     = 0.125
x3min     = 0.0
x3max     = 0.125

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.3
nlim       = -1
tlim       = 1.0
ndiag      = 100

<hydro>
eos         = ideal
gamma       = 1.6666666666666667
iso_sound_speed = 1.0     # used only with eos = isothermal
reconstruct = ppm4
rsolver     = hllc

<gravity>
solver    = multigrid
four_pi_G = 1.0       # replaced from n_jeans
threshold = -1        # fixed V-cycles, as in the magneto-Jeans suite
niteration = 8
full_multigrid = true
show_defect = 0

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = gravity
user_hist = true
rho0      = 1.0
p0        = 0.6       # cs^2 = gamma p0/rho0 = 1
amp       = 1.0e-4    # linear: second-order terms ~1e-8
n_jeans   = 2.0       # lambda / lambda_Jeans (> 1: unstable)
wave_dir  = x1

<output1>
file_type  = hst
dt         = 0.01
