# AthenaK input file: magneto-Jeans test with adaptive refinement, 2026-10-26.
# magneto_jeans.athinput with a moving refined slab (<problem>/amr_mode = window): every
# MeshBlock whose x1 extent overlaps |x1 - xc(t)| < win_hwidth is refined (to num_levels-1
# levels), all others derefined, with xc(t) = win_x0 + win_speed t wrapped into the box.
# The window crosses the wave while it runs, so blocks are created and destroyed under
# ideal MHD + multigrid gravity.  win_speed is set per case by the runner
# (validation/run/magneto_jeans_amr/magneto_jeans_amr.py) to two box crossings per run.

<comment>
problem   = magneto-Jeans wave (MHD + self-gravity)

<job>
basename  = MagJeans

<mesh>
nghost    = 4
nx1       = 64
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 8
x2min     = 0.0
x2max     = 0.125
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 8
x3min     = 0.0
x3max     = 0.125
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement = adaptive
num_levels = 2
refinement_interval = 1
max_nmb_per_rank = 512

<amr_criterion1>
method    = user      # <problem>/amr_mode (window)

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.3
nlim       = -1
tlim       = 1.0
ndiag      = 100

<mhd>
eos         = ideal       # adiabatic: AthenaK's isothermal HLLD is unstable at
gamma       = 1.6666666666666667   # beta <~ 1 (grid noise grows; 2026-10-26)
reconstruct = ppm4
rsolver     = hlld

<gravity>
solver    = multigrid
four_pi_G = 1.0       # replaced from n_jeans
threshold = -1        # fixed V-cycles: the defect's round-off floor grows with
niteration = 8        # resolution and 4 pi G, so no one absolute tolerance fits the suite
full_multigrid = true
show_defect = 0

<mhd_srcterms>
self_gravity = true

<problem>
pgen_name = gravity
user_hist = true
rho0      = 1.0
p0        = 0.6       # cs^2 = gamma p0/rho0 = 1
amp       = 1.0e-4    # linear: second-order terms ~1e-8
n_jeans   = 2.0       # lambda / lambda_Jeans (> 1: hydro-unstable)
wave_dir  = x1
b0        = 1.0       # vA = b0/sqrt(rho0)
b_angle   = 90.0      # angle between B0 and k (degrees)
mode      = fast      # slow | fast
amr_mode  = window    # moving refined slab
win_x0    = 0.5
win_hwidth = 0.125   # two root blocks wide
win_speed = 0.0       # set per case

<output1>
file_type  = hst
dt         = 0.01
