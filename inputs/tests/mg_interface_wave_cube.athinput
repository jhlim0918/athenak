# AthenaK input: static Poisson check of the multigrid force at a level jump, the genuinely
# 3-D variant of mg_interface_wave.athinput: a level-1 CUBE [0.25,0.75]^3 in a periodic unit
# cube and a fully 3-D wave k = 2 pi (2, 1, 1), so x3 faces, the edges of the refined
# region and the mixed transverse terms of the level-jump ghosts are all exercised.
# Ladder: mesh/nx1=nx2=nx3=N (N = 32, 64, 128) with 8^3 (default) or 16^3 MeshBlocks
# (meshblock/nx1=nx2=nx3=16), with and without mesh_refinement/refinement=none;
# <gravity> mg_fc_interp = linear | quadratic. See validation/mg_fc_quadratic_notes.md.
<comment>
problem = Static Poisson check of the multigrid force at a level jump: 3-D variant
          of R. Li's self_gravity_wave poisson test (refined cube [0.25,0.75]^3 in a
          periodic unit cube, wave (2,1,1), root 32-128, 8^3 blocks)

<job>
basename  = MGIWC

<mesh>
nghost    = 4
nx1       = 32
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 32
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 32
x3min     = 0.0
x3max     = 1.0
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = 0.2501           # pulls in exactly the blocks of [0.25, 0.75]^3
x1max = 0.7499
x2min = 0.2501
x2max = 0.7499
x3min = 0.2501
x3max = 0.7499

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0            # pgen-only test
tlim       = 1.0

<hydro>
eos         = isothermal
reconstruct = plm
rsolver     = llf
iso_sound_speed = 1.0

<gravity>
solver     = multigrid
four_pi_G  = 1.0
threshold  = -1           # fixed V-cycle count (niteration)
niteration = 30
full_multigrid = true
fmg_ncycle = 1
mg_fc_interp = quadratic  # level-jump ghosts: linear (default) | quadratic
show_defect = 0

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = mg_interface_wave
rho0  = 1.0
amp   = 0.1
phase = 0.37
nwx   = 2
nwy   = 1
nwz   = 1
