# AthenaK input file: multigrid self-gravity static-solve test on a refined (SMR)
# shearing box (Phase 2a: interior-ring refinement + shear-periodic x1).
# Same problem as fft_poisson_shear.athinput, but solver = multigrid with a level-1
# ring (full x2/x3 extent, interior in x1) and 16^3 MeshBlocks (4 x1 columns; the
# middle two are refined, so no refined block touches the shear boundary).
#
# Validation metrics (see validation/multigrid_selfgravity_validation.pdf):
# - profile=shwave, time0=0: bit-identical to the periodic-x1 twin
#   (override mesh/ix1_bc=periodic mesh/ox1_bc=periodic; compare bin DATA, not files —
#   the header echoes the input).
# - profile=shwave, generic phase (time0=0.37): l2_rel converges at 2nd order
#   (interface-limited); max_rel is the refinement-interface peak and converges at
#   1st order. The shear remap adds only a small 2nd-order l2 contribution.
# - profile=modes residual norms (max_rel_all etc.) are computed with a naive
#   per-block Laplacian and report O(1) at refinement interfaces BY CONSTRUCTION;
#   on refined meshes use the shwave analytic comparison instead.
# NOTE: SMR requires nghost even (4) and the multigrid solver cubic MeshBlocks.

<comment>
problem   = Multigrid Poisson on a refined shearing box (interior ring)

<job>
basename  = MGPoissonShearSMR

<mesh>
nghost    = 4         # Number of ghost cells
nx1       = 64        # Number of cells in X1-direction
x1min     = -0.5      # minimum value of X1
x1max     = 0.5       # maximum value of X1
ix1_bc    = shear_periodic  # Inner-X1 boundary condition flag
ox1_bc    = shear_periodic  # Outer-X1 boundary condition flag

nx2       = 64        # Number of cells in X2-direction
x2min     = -0.5      # minimum value of X2
x2max     = 0.5       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 64        # Number of cells in X3-direction
x3min     = -0.5      # minimum value of X3
x3max     = 0.5       # maximum value of X3
ix3_bc    = periodic  # Inner-X3 boundary condition flag
ox3_bc    = periodic  # Outer-X3 boundary condition flag

<meshblock>
nx1       = 16        # Number of cells in each MeshBlock, X1-dir
nx2       = 16        # Number of cells in each MeshBlock, X2-dir
nx3       = 16        # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.2      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0        # cycle limit (pgen-only test; no evolution)
tlim       = 1.0      # time limit
ndiag      = 1        # cycles between diagnostic output

<hydro>
eos         = isothermal  # EOS type
reconstruct = plm         # spatial reconstruction method
rsolver     = llf         # Riemann-solver to be used
iso_sound_speed = 1.0

<shearing_box>
qshear    = 1.5       # shear rate parameter q
omega0    = 1.0       # rotation frequency

<gravity>
solver    = multigrid       # fft | multigrid
four_pi_G = 1.0
vert_bc   = periodic  # periodic | open
fft_remap = ppmx      # dc | plm | ppmx (y-remap interpolation order)
# multigrid-solver settings (active only with solver=multigrid; ignored by fft)
threshold = 0.0       # 0.0 = automatic convergence control (stagnation exit)
niteration = 20       # used when threshold = -1 (fixed V-cycle count)
full_multigrid = true
fmg_ncycle = 1
show_defect = 0
mg_remap  = ppmx      # dc | plm | ppmx (shear ghost remap order)

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = fft_poisson   # problem generator name
profile   = modes         # modes | shwave (single rolled-frame mode, phi vs analytic)
rho0      = 1.0
amp       = 0.1
blob_amp  = 1.0
time0     = 0.37          # generic shear phase (Tshear = Ly/(q*Om*Lx) = 2/3 here)
n1        = 1             # shwave mode numbers (rolled frame)
n2        = 1
n3        = 1
slab_h    = 0.05          # slab scale height (profile = slab)

<output1>
file_type = bin
variable  = hydro_w
dt        = 1.0

<output2>
file_type = bin
variable  = grav_phi
dt        = 1.0

<mesh_refinement>
refinement = static
max_nmb_per_rank = 256

<refined_region1>
level = 1
x1min = -0.25
x1max = 0.25
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5
