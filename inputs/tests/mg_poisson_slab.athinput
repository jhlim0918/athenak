# AthenaK input file: multigrid self-gravity static-solve test with slab-open
# (vacuum) x3 boundaries (Phase 3).  Profile = sheet: uniform background rho0 plus a
# single horizontal Fourier mode (n1,n2) on the z-layer sheet_k.  The discrete
# infinite-vacuum solution is closed-form (mu-decay for the mode + the symmetric
# slab potential for the background), so "# FFT-POISSON SHEET ERROR" tests the
# mg_bc=slab boundary planes ABSOLUTELY (no mean subtraction, constant included);
# expected at the multigrid convergence threshold (~1e-10), NOT at discretization
# order.  16^3 MeshBlocks exercise the block-level boundary comm and plane indexing.
#
# Variants via CLI overrides:
#   problem/compare_fft=true          cross-check against the FFT KO09 open solver
#   problem/profile=modes             blob+modes density (residual norms only)

<comment>
problem   = Multigrid Poisson with slab-open x3 (sheet test)

<job>
basename  = MGPoissonSlab

<mesh>
nghost    = 3         # Number of ghost cells
nx1       = 64        # Number of cells in X1-direction
x1min     = -0.5      # minimum value of X1
x1max     = 0.5       # maximum value of X1
ix1_bc    = periodic  # Inner-X1 boundary condition flag
ox1_bc    = periodic  # Outer-X1 boundary condition flag

nx2       = 64        # Number of cells in X2-direction
x2min     = -0.5      # minimum value of X2
x2max     = 0.5       # maximum value of X2
ix2_bc    = periodic  # Inner-X2 boundary condition flag
ox2_bc    = periodic  # Outer-X2 boundary condition flag

nx3       = 64        # Number of cells in X3-direction
x3min     = -0.5      # minimum value of X3
x3max     = 0.5       # maximum value of X3
ix3_bc    = outflow   # Inner-X3 boundary condition flag
ox3_bc    = outflow   # Outer-X3 boundary condition flag

<meshblock>
nx1       = 16        # cubic MeshBlocks (multigrid requirement)
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic  # dynamic/kinematic/static
integrator = rk2      # time integrator
cfl_number = 0.2      # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = 0        # cycle limit (pgen-only test; no evolution)
tlim       = 1.0      # time limit
ndiag      = 1        # cycles between diagnostic output

<hydro>
eos         = isothermal  # EOS type
reconstruct = plm         # spatial reconstruction method
rsolver     = llf         # Riemann-solver to be used
iso_sound_speed = 1.0

<gravity>
solver    = multigrid # fft | multigrid
four_pi_G = 1.0
mg_bc     = slab      # slab-open (vacuum) x3 boundaries
vert_bc   = open      # used by the FFT solver when compare_fft=true
threshold = 0.0       # 0.0 = automatic convergence control (stagnation exit)
niteration = 20       # used when threshold = -1 (fixed V-cycle count)
full_multigrid = true
fmg_ncycle = 1
show_defect = 0

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = fft_poisson   # problem generator name
profile   = sheet         # uniform rho0 + one horizontal mode on layer sheet_k
rho0      = 1.0
amp       = 0.5
time0     = 0.0
n1        = 2
n2        = 1
n3        = 1
sheet_k   = 32            # z-layer index of the mode (default nz/2)
slab_h    = 0.05          # scale height for profile=slab (ln cosh comparison)
blob_amp  = 1.0           # blob amplitude for profile=modes
compare_fft = false

<output1>
file_type = bin
variable  = grav_phi
dt        = 1.0
