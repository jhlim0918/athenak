# AthenaK input file: minimal reproducer of the refined-mesh field error of the magnetized
# swing test (2026-10-27). Thin 3-D shearing box (64 x 64 x 4, 8 x 8 x 4 MeshBlocks), ideal MHD,
# NO self-gravity, NO orbital advection (the shear flow vy = -q Omega x is in the state), a
# uniform azimuthal field B0 = 1 (beta = 1.2, adiabatic cs = 1), and a leading shearing wave
# (kx0 = -6, ky = 1, amplitude 1e-4). A static level-1 ring over the central two of eight
# x1 block columns (|x| < pi/4) refines the wave as it swings (kx = 0 at t = 4).
# Run it twice -- as is, and with mesh_refinement/refinement=none -- and compare the user
# history column by_cos (the projected azimuthal field perturbation c_y): a correct
# refinement keeps the two within the uniform run's own truncation error (a few per cent);
# here they differ by ~22% by t = 6 (validation/run/swing_mhd_repro/repro.py).
# Facts so far: no field (b0 = 0) -> agreement; no shear (qshear = 0) -> the ring is better
# than uniform; uniform flow + field across a refinement slab without a shearing box
# (linear_wave_mhd_tflow_smr.athinput) -> no error; gravity irrelevant; the error barely
# converges with resolution (22% at a 64-cell root, 16% at 128). div B stays at round-off.
# NB: needs 3-D: AthenaK's 2-D shearing box is x-z only (r-phi "not yet implemented"), and a
# 2-D x-y run silently uses plain periodic x1 boundaries.
# With orbital advection (shearing_box/orbital_advection=true, branch fargo-amr-mhd,
# 2026-10-28) the same ring agrees with its uniform twin to 3% in c_y: the defect needs the
# shear flow carried in the state across the level interfaces.

<comment>
problem   = refined-mesh field error reproducer (MHD shearing box, no gravity)

<job>
basename  = SwingMHD

<mesh>
nghost    = 4
nx1       = 64
x1min     = -3.14159265358979
x1max     =  3.14159265358979
ix1_bc    = shear_periodic
ox1_bc    = shear_periodic
nx2       = 64
x2min     = -3.14159265358979
x2max     =  3.14159265358979
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 4
x3min     = -0.39269908169872
x3max     =  0.39269908169872
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 4

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 6.0        # swing at t = 4; the error is fully developed by t = 6
ndiag      = 100

<mhd>
eos         = ideal
gamma       = 1.6666666666666667
reconstruct = plm
rsolver     = hlld
iso_sound_speed = 1.0   # used only with eos = isothermal

<shearing_box>
qshear = 1.5
omega0 = 1.0
orbital_advection = false # false = non-FARGO: integrate the full shear flow
oa_annular = true         # with orbital advection + refinement: refined regions in full
                          # x2 rings (required for MHD); no effect otherwise
oa_flux_correct = true    # false: switch off the OA flux / EMF correction (tests only)


<problem>
pgen_name = swing
rho0      = 1.0
p0        = 0.6         # cs^2 = gamma p0/rho0 = 1
b0        = 1.0         # uniform B along x2: vA = 1, beta = 1.2
amp       = 1.0e-4      # small enough to stay linear through the amplification
nwx       = -6          # leading wave (kx0 < 0)
nwy       = 1
user_hist = true

<output1>
file_type      = hst
dt             = 0.02
data_format    = %14.7e
user_hist_only = true

<mesh_refinement>
refinement = static
prolong_primitives = false   # true: prolongate primitives (exact for a uniform P)
max_nmb_per_rank = 1024

<refined_region1>
level = 1
x1min = -0.78
x1max =  0.78
x2min = -3.14159265358979
x2max =  3.14159265358979
x3min = -0.39269908169872
x3max =  0.39269908169872
