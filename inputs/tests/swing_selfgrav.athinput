# AthenaK input file for the swing-amplification test of FFT self-gravity.
#
# A single leading shearing wave (nwx < 0, nwy = 1, kz = 0) of small amplitude is wound
# up by the background shear; kx(t) = kx0 + q*Omega*ky*t sweeps through zero at
# t_swing = -nwx/(q*nwy) = 4.0, where self-gravity transiently amplifies it.
#
# Parameters are chosen in the epicyclic-resonant regime that makes swing strong:
# with Lx = Ly = 2*pi and nwy = 1 we get ky = 1 = kappa (kappa^2 = 2(2-q)Omega^2 = 1),
# and 4*pi*G*rho0 = 1.9 sits just below the marginal value ky^2 cs^2 + kappa^2 = 2,
# so every box mode stays Jeans-stable while the swinging wave is strongly amplified
# (linear theory predicts a peak amplification of ~3.6).
#
# The user history file (<basename>.user.hst) records the projection of the solution
# onto the instantaneous shearing wavevector: d_cos, d_sin, vx_sin, vy_sin, kx/ky.
# Compare with the linear ODE integrated in validation/fft_selfgravity_tests.ipynb.
# Control run (gravity off): add   <hydro_srcterms>/self_gravity=false  and set
# gravity/four_pi_G=0 in the ODE; the wave should then show no net amplification.

<comment>
problem   = Swing amplification with self-gravity

<job>
basename  = SwingSG

<mesh>
nghost    = 3
nx1       = 128
x1min     = -3.14159265358979
x1max     =  3.14159265358979
ix1_bc    = shear_periodic
ox1_bc    = shear_periodic

nx2       = 128
x2min     = -3.14159265358979
x2max     =  3.14159265358979
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 16
x3min     = -0.39269908169872
x3max     =  0.39269908169872
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 64
nx2       = 64
nx3       = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 8.0        # 2 x t_swing
ndiag      = 100

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = hlle
iso_sound_speed = 1.0

<shearing_box>
qshear = 1.5
omega0 = 1.0
orbital_advection = true  # false = non-FARGO: integrate the full shear flow

<gravity>
solver    = fft
four_pi_G = 1.9
vert_bc   = periodic
fft_remap = ppmx
# multigrid-solver settings (active only with solver=multigrid; ignored by fft)
threshold = 0.0
full_multigrid = true
fmg_ncycle = 1
mg_remap  = ppmx

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = swing
rho0      = 1.0
amp       = 1.0e-4      # small enough to stay linear through the amplification
nwx       = -6          # leading wave (kx0 < 0)
nwy       = 1
user_hist = true

<output1>
file_type      = hst
dt             = 0.02
data_format    = %14.7e
user_hist_only = true
