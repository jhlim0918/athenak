# AthenaK input: 256^2 two-mode collapse (psi = 2.3) with density-triggered AMR --
# the deep stress test of the Phase-2 machinery: AMR + FARGO + shear-periodic
# multigrid gravity at 64 ranks, rings chasing a genuinely nonlinear collapse.
#
# Base run: swing_mg_uniform_256_phase2_2.3 (uniform twin of this file with
# refinement=none). Its census: dominant knot 8.8e4*rho0 at (-1.755, +1.559) by
# t=9, secondary 1.1e4 at (-2.908, -2.295); runaway is late/shallow enough that
# the uniform run completed to t=14.
#
# LESSON FROM THE FIRST ATTEMPT (value_max=10, max_nmb_per_rank=160, crashed at
# t=4.495): the criterion fires on the SWING TRANSIENT, not only on the clumps --
# the over-compressed crest exceeds 10*rho0 across many x1 columns at t~4.4, and
# under the annular policy every flagged column becomes a full ring at every level
# it qualifies for: 10,144 blocks (288 root + 640 L1 + 9216 L2) in the t=4.5
# snapshot, 11,264 wanted at the fatal remesh (176/rank x 64). The cap guard
# aborted cleanly; zero multigrid warnings; AMR history bitwise identical to the
# uniform twin until the first remesh (t=4.37). Hence the two settings below.
#
# AMR design notes (checked against mesh_refinement.cpp):
# - value_max = 50 keeps the rings off the bouncing swing transient and fires on
#   the genuine collapse (the uniform twin crosses 50 near t~7.8). value_max = 10
#   is the maximal stress test (near-full level-2 through the swing, then mass
#   derefinement at the bounce): ask for >= 12 h walltime.
# - max_nmb_per_rank = 512 is the HARD CEILING for 64 ranks (the whole box at
#   level 2 = 32768 blocks = 512/rank), so the cap fatal cannot fire. It is a
#   per-rank limit: serial/low-rank tests of this file need it raised further.
# - num_levels = 3 (root + 2). Refinement windows under the graded cap: root
#   blocks may refine in any interior column (never the two shear-boundary
#   columns); level-1 blocks may refine only with level-1 column index in [3,28]
#   (|x| < 2.55); level-2 blocks only with level-2 index in [7,56] (|x| < 2.45).
#   The dominant knot (x = -1.755) is inside all three windows, so num_levels = 4
#   is viable at the main knot (8x ring cost per level). The secondary knot
#   (x = -2.91, boundary column 0) can never be refined: policy, not an error.
# - dt is set globally by the finest level; each refined column-ring = 256 (L1)
#   / 1024 (L2) MeshBlocks. Expect the runaway dt-crawl to end the useful span
#   past t ~ 9-10 (walltime, not tlim, decides; restart dumps every 0.5).
#   Past-ceiling densities remain unphysical at every level.
#
# Cluster launch (64 ranks; no CLI overrides needed):
#   mpiexec -np 64 -ppn 32 $ATH/build-mpi/src/athena \
#     -i $ATH/inputs/tests/swing_selfgrav_clump_amr256_2m.athinput

<comment>
problem   = Two-mode swing collapse (psi=2.3) with density-triggered AMR, 256^2

<job>
basename  = clump_2m_b256amr

<mesh>
nghost    = 4
nx1       = 256
x1min     = -3.14159265358979
x1max     =  3.14159265358979
ix1_bc    = shear_periodic
ox1_bc    = shear_periodic

nx2       = 256
x2min     = -3.14159265358979
x2max     =  3.14159265358979
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 32
x3min     = -0.39269908169872
x3max     =  0.39269908169872
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 14.0
ndiag      = 100

<hydro>
eos             = isothermal
reconstruct     = plm
rsolver         = hlle
iso_sound_speed = 1.0

<shearing_box>
qshear = 1.5
omega0 = 1.0
orbital_advection = true   # FARGO on -> annular refinement policy (rings)

<gravity>
solver    = multigrid
four_pi_G = 6.0
vert_bc   = periodic
fft_remap = ppmx
threshold = -1             # fixed-count mode (stagnation control can hit the
niteration = 10            # 40-cycle cap mid-run on refined meshes)
full_multigrid = true
fmg_ncycle = 1
mg_remap  = ppmx

<hydro_srcterms>
self_gravity = true

<problem>
amr_moving_ring = false    # density criterion below, not the prescribed ring
ring_xc0     = 0.0
ring_xamp    = 0.0
ring_freq    = 1.0
ring_hwidth  = 0.19634954084936
pgen_name = swing
rho0      = 1.0
amp       = 0.2
nwx       = -6             # primary leading wave
nwy       = 1
phase0    = 0.0
nwx2      = -11            # second leading wave: breaks all parity (generic sites)
nwy2      = 2
amp2      = 0.1
phase2    = 2.3
user_hist = true

<mesh_refinement>
refinement = adaptive
num_levels = 3             # root + 2 refinement levels (4 viable at the main knot)
refinement_interval = 5
max_nmb_per_rank = 512     # hard ceiling at 64 ranks (whole box at level 2); PER RANK

<amr_criterion1>
method    = min_max
variable  = hydro_u_d
value_max = 50.0           # clump-chasing; 10.0 = maximal stress test (see header)

<output1>
file_type      = hst
dt             = 0.02
data_format    = %14.7e
user_hist_only = true

<output2>
file_type      = bin
variable       = hydro_u_d
dt             = 0.25

<output3>
file_type      = rst
dt             = 0.5       # restart dumps (cluster walltime insurance)
