#PBS -S /bin/bash
#PBS -N gt_sc14_b10hi
#PBS -l select=1:ncpus=256:mpiprocs=256:model=tur_ath
#PBS -l walltime=48:00:00
#PBS -q long
#PBS -j oe
#PBS -W group_list=s3183
#PBS -m be
#PBS -M jay.lim1@unlv.edu

# Submit from the run directory:   cd <rundir> && qsub <repo>/scripts/cluster/gt_sc14_full.pbs
# To continue a run, replace the -i line with:  -r $(ls rst/*.rst | tail -1) \
# Per-run parameters go on the mpiexec line, e.g.  hydro_srcterms/bcool_beta=5

ATHENAK=$HOME/athenak
INPUT=$ATHENAK/inputs/shearing_box/gravito_turb_sc14_hi.athinput

source /opt/cray/pe/modules/3.2.11.7/init/bash
module load PrgEnv-intel
module use /opt/cray/pals/modulefiles
module load cray-pals cray-fftw

# ranks and ranks-per-node straight from the allocation (fills every node)
NRANKS=$(wc -l < $PBS_NODEFILE)
PPN=$(( NRANKS / $(sort -u $PBS_NODEFILE | wc -l) ))

cd $PBS_O_WORKDIR
mpiexec -np $NRANKS -ppn $PPN $ATHENAK/build-cluster/src/athena \
        -i $INPUT -d ./ -t 47:45:00 >> run.log 2>&1
