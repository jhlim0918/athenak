# AthenaK input: static Poisson check of the multigrid force at a level jump (R. Li's
# self_gravity_wave poisson test). Ladder: mesh/nx1=nx2=N, mesh/x3max=refined_region1/x3max=4/N
# (N = 16..256), with and without mesh_refinement/refinement=none; see validation/run/mg_interface/README.md.
<comment>
problem = Static Poisson check of the multigrid force at a level jump: R. Li's
          self_gravity_wave poisson test (2-D, refined square [0.25,0.75]^2, root 16-256,
          4-cell blocks) as a 3-D slab one 4^3 block thick (our multigrid needs cubic blocks)

<job>
basename  = MGIW

<mesh>
nghost    = 4
nx1       = 16
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 16
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 4
x3min     = 0.0
x3max     = 0.25          # 4 cells of 1/16: replaced by 4/N for root N
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 4
nx2       = 4
nx3       = 4

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = 0.2501           # pulls in exactly the blocks of [0.25, 0.75]
x1max = 0.7499
x2min = 0.2501
x2max = 0.7499
x3min = 0.0
x3max = 1.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 0            # pgen-only test
tlim       = 1.0

<hydro>
eos         = isothermal
reconstruct = plm
rsolver     = llf
iso_sound_speed = 1.0

<gravity>
solver     = multigrid
four_pi_G  = 1.0
threshold  = 0.0          # automatic convergence control (stagnation exit)
niteration = 50
full_multigrid = true
mg_fc_interp = quadratic
show_defect = 0
fmg_ncycle = 1

<hydro_srcterms>
self_gravity = true

<problem>
pgen_name = mg_interface_wave
rho0  = 1.0
amp   = 0.1
phase = 0.37
nwx   = 2
nwy   = 1
nwz   = 0
